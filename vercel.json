{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/neon/auth/:path*",
      "destination": "https://ep-red-thunder-bgarx58x.neonauth.c-9.eu-central-1.aws.neon.tech/helio/auth/:path*"
    },
    {
      "source": "/neon/rest/:path*",
      "destination": "https://ep-red-thunder-bgarx58x.apirest.c-9.eu-central-1.aws.neon.tech/helio/rest/:path*"
    },
    {
      "source": "/sb/:path*",
      "destination": "https://xyyvgpchkznznwbxbgrp.supabase.co/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
